{
  "name": "medora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts README.md index.html package.json",
    "format:check": "prettier --check src scripts README.md index.html package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "node --experimental-strip-types scripts/qa.mjs",
    "sitemap": "node --experimental-strip-types scripts/generate-sitemap.mjs",
    "build": "npm run qa && npm run lint && npm run typecheck && npm run test && npm run sitemap && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^2.1.0",
    "vitest-axe": "^0.1.0"
  }
}
